{
  "name": "anypress-theme-tests",
  "private": true,
  "type": "module",
  "description": "Checks the AnyPress theme on WordPress Playground: theme loads, patterns are valid blocks and use only theme tokens, pages render on phone and desktop.",
  "engines": {
    "node": ">=24.18"
  },
  "scripts": {
    "theme": "node theme-check.mjs",
    "wporg": "node wporg-check.mjs",
    "serve": "node theme-check.mjs --serve",
    "contrast": "node contrast.mjs",
    "demo": "node demo.mjs"
  },
  "dependencies": {
    "@wordpress/block-library": "12.1.0",
    "@wordpress/blocks": "17.1.0",
    "@wp-playground/cli": "3.1.64",
    "global-jsdom": "31.0.0",
    "jsdom": "30.1.3"
  }
}
